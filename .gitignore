__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/

# Training artefacts
wandb/
runs/
checkpoints/
*.eval

# Level datasets (generated, not tracked). Anchored: an unanchored `data/`
# also swallowed figures/data, where measured results live.
/data/

# Ad-hoc editing backups. Kept on disk, out of the history: the notes they back
# up are tracked, so a committed copy is a second version of the same document
# with nothing to say which is current.
*.pre-push-backup.md
*.stage2-backup-*.md

# Figure source data. Measured on the pod, archived on the network volume
# (rahul-goalmisgen-data:/data/figures-data); the repo keeps code, write-ups,
# results/ tables and the rendered figures. Files tracked before this policy
# stay tracked - an ignore never untracks.
/figures/data/
